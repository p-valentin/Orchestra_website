# Destination address for contact-form submissions (server-only, never exposed to the client)
CONTACT_EMAIL=hello@orchestra-automation.com

# Optional: Resend API key. If set, contact submissions are emailed via Resend.
# If unset, submissions are validated + rate-limited + logged server-side only.
RESEND_API_KEY=

# Optional: the "from" address Resend sends as (must be a verified domain on your Resend account)
RESEND_FROM=Orchestra <noreply@orchestra-automation.com>

# Cloudflare R2 public bucket URL — used by the download tracking route
R2_DOWNLOAD_BASE_URL=https://downloads.orchestra-automation.com

# Admin area password (session login on /admin). Without it /admin returns 404.
# Use a long random value, e.g.:  openssl rand -base64 24
ADMIN_PASSWORD=

# Optional second factor for /admin login (RFC 6238 TOTP, base32 secret).
# When set, the login form also requires a 6-digit authenticator code.
# Generate:  node -e "const a='ABCDEFGHIJKLMNOPQRSTUVWXYZ234567';console.log([...require('crypto').randomBytes(20)].map(b=>a[b%32]).join(''))"
# Enroll it in an authenticator app by adding the key manually, or via the URI:
#   otpauth://totp/Orchestra%20admin?secret=<SECRET>&issuer=Orchestra
ADMIN_TOTP_SECRET=

# Private R2 bucket for admin data (releases + stats). Use a PRIVATE bucket,
# never the public downloads one. Without these, data is stored in .data/
# (works locally, not on Vercel).
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Ed25519 PRIVATE key for signing license tokens (PEM, or single-line base64 of
# the PEM). The matching PUBLIC key is baked into the desktop app at build time
# (vite.config.ts). Without this, /api/claim and the /api/license/* routes
# (register/login/refresh — the app's server verification) return not-configured.
# Generate the pair:  node -e "const c=require('crypto');const{publicKey,privateKey}=c.generateKeyPairSync('ed25519');console.log(privateKey.export({type:'pkcs8',format:'pem'}));console.log(publicKey.export({type:'spki',format:'pem'}))"
LICENSE_PRIVATE_KEY=

# ISO-8601 moment the free-license window closes (server-enforced; claims are
# rejected after it, no redeploy needed). Unset = count-limited only.
CLAIM_CUTOFF=

# Supabase licensing backend (Phase 1-3). Public values — they ship in the
# browser bundle for the /signup and /reset-password pages. Every table is
# behind RLS; all licensing writes happen in Edge Functions with the service
# role, which never touches this repo.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key from the Supabase dashboard>

# Paddle Billing overlay checkout (the ONLY purchase path — a hosted checkout
# link can't carry the account's user_id, so none is supported). Public values;
# they ship in the browser bundle. Until they're set, buy buttons render
# disabled with a "checkout opens at launch" hint.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=<test_… (sandbox) or live_… (production)>
NEXT_PUBLIC_PADDLE_PRICE_ID=<pri_… id of the $129 lifetime price>
NEXT_PUBLIC_PADDLE_ENV=sandbox

# Pre-launch switches (both default OFF). Flip to "1" in Vercel once the live
# payment path is verified, then redeploy. Buy also needs the NEXT_PUBLIC_PADDLE_*
# keys above — the flag is the deliberate go-live switch on top of them.
NEXT_PUBLIC_PAID_ENABLED=
NEXT_PUBLIC_SIGNUP_ENABLED=
