# Destination address for contact-form submissions (server-only, never exposed to the client)
CONTACT_EMAIL=hello@orchestra-automation.com

# Optional: Resend API key. If set, contact submissions are emailed via Resend.
# If unset, submissions are validated + rate-limited + logged server-side only.
RESEND_API_KEY=

# Optional: the "from" address Resend sends as (must be a verified domain on your Resend account)
RESEND_FROM=Orchestra <noreply@orchestra-automation.com>
